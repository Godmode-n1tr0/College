<Page x:Class="Shengals_Shop.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Shengals_Shop.Pages"
      mc:Ignorable="d" 
      Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Административная панель" FontSize="50"  TextAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Center"></TextBlock>
            <DataGrid x:Name="UserGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn FontSize="24" Header="Фамилия Имя Отчество" Binding="{Binding fio}" Width="*"/>
                    <DataGridTextColumn FontSize="24" Header="Логин" Binding="{Binding login}" Width="*"/>
                    <DataGridTextColumn FontSize="24" Header="Пароль" Binding="{Binding password}" Width="*"/>
                    <DataGridTextColumn FontSize="24" Header="Роль" Binding="{Binding roleText}" Width="*"/>
                    <DataGridTextColumn FontSize="24" Header="admin" Binding="{Binding Role}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Width="300" Height="65" Margin="0 20" CornerRadius="20" Background="red">
                <Button Content="Выход" Background="Transparent" BorderBrush="Transparent" Foreground="white" FontSize="25" Click="Exit_Click"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
