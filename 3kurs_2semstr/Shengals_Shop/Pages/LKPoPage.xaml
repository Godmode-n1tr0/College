<Page x:Class="Shengals_Shop.Pages.LKPoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Shengals_Shop.Pages"
      mc:Ignorable="d" 
      Background="white"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LKPoPage">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding fio, StringFormat='Добро Пожаловать {0}'}" FontSize="50" HorizontalAlignment="Center"></TextBlock>
            <Border Width="100" Height="70" CornerRadius="20" Background="red">
                <Button Content="Выход" Background="Transparent" BorderBrush="Transparent" Foreground="white" FontSize="25" Click="Exit_Click"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
