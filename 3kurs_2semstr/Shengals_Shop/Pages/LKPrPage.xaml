<Page x:Class="Shengals_Shop.Pages.LKPrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Shengals_Shop.Pages"
      mc:Ignorable="d" 
      Background="white"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LKPrPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" Grid.Row="0">
            <TextBlock Text="{Binding fio, StringFormat='Добро пожаловать {0}'}" FontSize="30" HorizontalAlignment="Center"/>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="ProductGrid">
            <DataGrid.Columns>
                <DataGridTextColumn FontSize="24" Width="1*" Header="Продукт" Binding="{Binding Product.Name}"/>
                <DataGridTextColumn FontSize="24" Width="1*" Header="Категория" Binding="{Binding Category.NameCategory}"/>
                <DataGridTextColumn FontSize="24" Width="1*" Header="Вид" Binding="{Binding viev.viewName}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <Border Width="150" Height="50" Background="Red" BorderThickness="1" BorderBrush="black" CornerRadius="10">
                <Button Background="Transparent" Click="Exit_Btn" BorderBrush="Transparent" Foreground="white" FontSize="24" Content="Выход"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
