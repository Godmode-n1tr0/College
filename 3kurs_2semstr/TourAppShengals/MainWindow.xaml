<Window x:Class="TourAppShengals.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TourAppShengals"
        Title="MainWindow" 
        Height="450" 
        Width="800">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="TextBoxTour">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Background" Value="#FF00CCCC"/>
            <Setter Property="Foreground" Value="black"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="Button" x:Key="ButtonBack">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Content" Value="Назад"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0 0 5 0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Width" Value="150"/>
        </Style>

        <Style TargetType="Grid" x:Key="RowGridOne">
            <Setter Property="Background" Value="#FF00CCCC"/>
        </Style>

        <Style TargetType="Grid" x:Key="RowGridThree">
            <Setter Property="Background" Value="DarkBlue"/>
        </Style>

        <Style TargetType="Image" x:Key="Logo">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Source" Value="/Resources/Image1.png"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource RowGridOne}">
            <Image Style="{StaticResource Logo}"/>
            <TextBox Style="{StaticResource TextBoxTour}" Text="ТурАгенство"/>
            <Button x:Name="BtnBack" Click="BtnBack_Click" Style="{StaticResource ButtonBack}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Frame Name="MainFrame" ContentRendered="MainFrame_ContentRendered"></Frame>
        </Grid>

        <Grid Grid.Row="2" Style="{StaticResource RowGridThree}"/>
    </Grid>
</Window>