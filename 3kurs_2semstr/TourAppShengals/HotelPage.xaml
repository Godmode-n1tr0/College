<Page x:Class="TourAppShengals.HotelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TourAppShengals"
      mc:Ignorable="d"
      Background="white"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HotelPage" IsVisibleChanged="Page_IsVisibleChanged">
    <Page.Resources>
        <Style TargetType="Button" x:Key="BtnTemplate">
            <Setter Property="Content" Value="Редактировать"/>
        </Style>
        <Style TargetType="Button" x:Key="BtnAdd">
            <Setter Property="Content" Value="Добавить"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5 10 5 10"/>
            <Setter Property="Background" Value="white"/>
            <Setter Property="Width" Value="175"/>
            <Setter Property="FontSize" Value="30"/>
        </Style>
        <Style TargetType="Button" x:Key="BtnDel">
            <Setter Property="Content" Value="Удалить"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="5 10 5 10"/>
            <Setter Property="Background" Value="white"/>
            <Setter Property="Width" Value="175"/>
            <Setter Property="FontSize" Value="30"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="377*"/>
            <RowDefinition Height="103*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <DataGrid x:Name="DGridHotel" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn  Header="Название отеля" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn  Header="Кол-во звезд" Binding="{Binding CountOfStar}" Width="*"/>
                    <DataGridTextColumn  Header="Страна" Binding="{Binding Country.Name}" Width="*"/>
                    <DataGridTemplateColumn Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Name="BtnEdit"  Click="BtnEdit_Click" Style="{StaticResource BtnTemplate}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="1">
            <Button Style="{StaticResource BtnAdd}" Click="BtnAdd"/>
            <Button Style="{StaticResource BtnDel}" Click="BtnDel"/>
        </Grid>
    </Grid>
</Page>
