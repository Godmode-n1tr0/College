<Window x:Class="LibraryShengals.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryShengals"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Window.Resources>
        <Style TargetType="TextBox" x:Key="TextBoxTour">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Text" Value="Библиотека"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.6,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="Button" x:Key="ButtonBack">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Content" Value="Назад"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0 0 5 0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="Width" Value="150"/>
        </Style>

        <Style TargetType="Grid" x:Key="RowGridOne">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Grid" x:Key="RowGridThree">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Style="{StaticResource RowGridOne}">
            <TextBox Style="{StaticResource TextBoxTour}"/>
            <Button HorizontalAlignment="Left" Width="auto" Margin="5 5 0 0" VerticalAlignment="Top" Foreground="white" Height="auto" FontSize="18" Background="{x:Null}" Content="Таблица авторов" Click="BtnTableAuthor"/>
            <Button HorizontalAlignment="Left" Width="auto" Margin="5 0 0 5" VerticalAlignment="Bottom" Height="auto" FontSize="18" Background="{x:Null}" Content="Таблица Книг" Click="BtnTableBooks"/>
            <Button x:Name="BtnBack" Click="BtnBack_Click" Style="{StaticResource ButtonBack}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Frame Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"></Frame>
        </Grid>

        <Grid Grid.Row="2" Style="{StaticResource RowGridThree}"/>
    </Grid>
</Window>
