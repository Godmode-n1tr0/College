<Page x:Class="LibraryShengals.Pages.AddBooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryShengals.Pages"
      Background="White"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddBooksPage">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="Name">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="PublicationYear">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="2"/>
            <Setter Property="Grid.Column" Value="0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Author">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Genres">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="3"/>
            <Setter Property="Grid.Column" Value="0"/>
        </Style>
        <Style TargetType="TextBox" x:Key="TextBoxOne">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Width" Value="550"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="{Binding Title}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style TargetType="TextBox" x:Key="TextBoxThree">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Text" Value="{Binding PublicationYear, StringFormat={}{0:dd.MM.yyyy}}"/>
            <Setter Property="Width" Value="550"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="2"/>
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="ComboBoxTwo">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Width" Value="550"/>
            <Setter Property="SelectedItem" Value="{Binding Authors.fullName}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="ComboBoxOne">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Width" Value="550"/>
            <!--<Setter Property="SelectedItem" Value="{Binding Genres}"/>-->
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Grid.Row" Value="3"/>
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style TargetType="Button" x:Key="BtnSave">
            <Setter Property="Content" Value="Сохранить"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="30"/>
            <Setter Property="Background" Value="white"/>
            <Setter Property="Width" Value="195"/>
            <Setter Property="Grid.Row" Value="5"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="FontSize" Value="30"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Name}">Заголовок</TextBlock>
        <TextBlock Style="{StaticResource Author}">Автор</TextBlock>
        <TextBlock Style="{StaticResource Genres}">Жанры</TextBlock>
        <TextBlock Style="{StaticResource PublicationYear}">Дата Публикации</TextBlock>
        <TextBox Style="{StaticResource TextBoxOne}"/>
        <DatePicker SelectedDate="{Binding PublicationYear}" Grid.Row="2" Grid.Column="1"></DatePicker>
        <ComboBox SelectedItem="{Binding Genres}" x:Name="ComboGenres" DisplayMemberPath="Name" Style="{StaticResource ComboBoxOne}"/>
        <ComboBox SelectedItem="{Binding Authors}" x:Name="ComboAuthor" DisplayMemberPath="fullName" Style="{StaticResource ComboBoxTwo}"/>
        <Button Style="{StaticResource BtnSave}" Click="SaveBtn_Click" Name="SaveBtn"/>
    </Grid>
</Page>
