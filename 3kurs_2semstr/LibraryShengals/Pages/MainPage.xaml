<Page x:Class="LibraryShengals.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryShengals"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"

      Title="MainPage">
    <Page.Resources>
        <Style TargetType="Button" x:Key="BtnTemplate">
            <Setter Property="Content" Value="Редактировать"/>
        </Style>
        <Style TargetType="Button" x:Key="BtnAdd">
            <Setter Property="Content" Value="Добавить"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5 10 5 10"/>
            <Setter Property="Background" Value="white"/>
            <Setter Property="Width" Value="175"/>
            <Setter Property="FontSize" Value="25"/>
        </Style>
        <Style TargetType="Button" x:Key="BtnAddGenre">
            <Setter Property="Content" Value="Добавить жанр"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5 10 5 10"/>
            <Setter Property="Background" Value="white"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="25"/>
        </Style>
        <Style TargetType="Button" x:Key="BtnDel">
            <Setter Property="Content" Value="Удалить"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="5 10 5 10"/>
            <Setter Property="Background" Value="white"/>
            <Setter Property="Width" Value="175"/>
            <Setter Property="FontSize" Value="25"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="Введите текст для поиска: " FontSize="24" TextAlignment="Left"></TextBlock>
            <TextBox HorizontalAlignment="Center" Width="210" FontSize="24" Name="TBoxSearc" TextChanged="TBoxSearc_TextChanged"/>
        </Grid>
        <Grid Grid.Row="1" Width="auto" Height="auto">
            <DataGrid x:Name="DGridLibrary" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn  Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn  Header="Автор" Binding="{Binding Authors.fullName}" Width="*"/>
                    <DataGridTextColumn  Header="Год публикации" Binding="{Binding PublicationYear, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                    <DataGridTextColumn  Header="Жанр" Binding="{Binding Genres.Name}" Width="*"/>
                    <DataGridTemplateColumn Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Name="BtnEdit"  Click="BtnEdit_Click" Style="{StaticResource BtnTemplate}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="2">
            <Button Style="{StaticResource BtnAdd}" Click="BtnAdd"/>
            <Button Style="{StaticResource BtnAddGenre}" Click="BtnAddGenre"/>
            <Button Style="{StaticResource BtnDel}" Click="BtnDel"/>
        </Grid>
    </Grid>
</Page>
