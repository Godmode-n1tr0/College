<Page x:Class="ShengalsBase.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShengalsBase.Pages"
      mc:Ignorable="d" 
      Background="white"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Административная панель" FontSize="50" TextAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            <Border Width="100" Height="70" CornerRadius="20" Background="red">
                <Button Content="Выход" Background="Transparent" BorderBrush="Transparent" Foreground="white" FontSize="25" Click="Exit_Click"/>
            </Border>
            <DataGrid x:Name="UserGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn  Header="Фамилия Имя Отчество" Binding="{Binding fio}" Width="*"/>
                    <DataGridTextColumn  Header="Логин" Binding="{Binding login}" Width="*"/>
                    <DataGridTextColumn  Header="Пароль" Binding="{Binding password}" Width="*"/>
                    <DataGridTextColumn  Header="Роль" Binding="{Binding adminText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
